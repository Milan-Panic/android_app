<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!--
      Običan ViewFlipper (ne AdapterViewFlipper): svaka slika je zaseban prikaz
      sa sopstvenim, direktnim klikom. Sam smenjuje slike svake 2 sekunde.
    -->
    <ViewFlipper
        android:id="@+id/widgetFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="2000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out" />

    <!-- Prikazuje se kad nema slika ili nema dozvole -->
    <TextView
        android:id="@+id/widgetMessage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
